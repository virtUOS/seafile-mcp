# Copy to .env and fill in. Only the first two are required.

# The Seafile instance every user of this deployment authenticates against.
SEAFILE_SERVER_URL=https://seafile.example.org

# Public hostname for this MCP server; Caddy obtains a certificate for it.
MCP_DOMAIN=seafile-mcp.example.org

# read_only | safe_write | full
#   read_only  - no mutating tools registered at all
#   safe_write - default; write/upload/mkdir/rename/move/copy, all reversible
#   full       - additionally exposes delete
# Tools outside the active tier are never registered, so the model cannot call
# what it cannot see. Leave at safe_write unless you specifically need delete;
# users can always delete from the Seafile web interface, where a human is
# genuinely in the loop.
SEAFILE_MCP_MODE=safe_write

# Upload size cap (MB) and how many items a single delete may remove.
SEAFILE_MCP_MAX_UPLOAD_MB=50
SEAFILE_MCP_MAX_DELETE_ITEMS=50

# Optional: restrict access to accounts in these email domains (comma separated).
# Applies to account tokens only. Leave empty to allow any valid Seafile token.
SEAFILE_MCP_ALLOWED_EMAIL_DOMAINS=

# Optional: force the search tool on/off. Left empty, the server probes the
# instance at startup — Seafile search is a Professional-edition feature and is
# absent on Community Edition.
SEAFILE_MCP_ENABLE_SEARCH=true

# A bare seafile_read_file call on a PDF longer than this many pages returns only
# a short preview instead of the whole document, to keep a single call cheap.
# Set to "all" to always extract the whole document regardless of length.
SEAFILE_MCP_PDF_PREVIEW_THRESHOLD_PAGES=15

# Same idea as above, for PowerPoint decks longer than this many slides.
# Set to "all" to always extract the whole deck regardless of length.
SEAFILE_MCP_PPTX_PREVIEW_THRESHOLD_SLIDES=20

# Same idea, for Excel workbooks with more than this many sheets — a bare call
# extracts only the first sheet instead of all of them. Set to "all" to always
# extract every sheet regardless of count.
SEAFILE_MCP_XLSX_PREVIEW_THRESHOLD_SHEETS=5

# Images. seafile_read_file returns an image file as an image the model can see
# directly, not as text. These bound what that costs: the long edge it is
# scaled down to, and a ceiling on the re-encoded bytes (before base64 inflates
# them by a third). They bound the model's context, not just bandwidth — a tool
# result goes straight into the context window.
SEAFILE_MCP_MAX_IMAGE_EDGE_PX=1568
SEAFILE_MCP_MAX_IMAGE_MB=5

# Set to false for a client that cannot render image blocks, or a model with no
# vision. Images then come back as a short text description plus a pointer to
# seafile_get_download_link, instead of a block the host would silently drop.
SEAFILE_MCP_IMAGE_READS=true

# OCR (optional). Off unless BOTH of the first two are set; setting only one is a
# startup error. When on, the seafile_ocr_file tool appears: it transcribes
# scanned PDF pages and images through a separate OCR model behind any
# OpenAI-compatible chat-completions API (vLLM serving LightOnOCR is the
# reference), and seafile_read_file transcribes a PDF's scanned pages itself.
# Only pages without a text layer are sent to the model, so typed PDFs cost
# nothing. Page images of library files go to this host — see docs/deploy.md
# before pointing it anywhere.
# SEAFILE_MCP_OCR_URL=https://gpu.example.org:8010/v1
# SEAFILE_MCP_OCR_MODEL=lightonai/LightOnOCR-2-1B
# SEAFILE_MCP_OCR_API_KEY=

# Text sent with each page image. Empty for LightOnOCR; models such as olmOCR
# or a general vision model need their OCR instruction here.
# SEAFILE_MCP_OCR_PROMPT=

# Long edge each page is rendered/scaled to: 1540 for LightOnOCR-2-1B,
# 2048 for LightOnOCR-3-0.8B/-4B.
# SEAFILE_MCP_OCR_MAX_EDGE_PX=1540

# Pages per call, requests in flight across all users, per-page timeout and
# per-page output cap.
# SEAFILE_MCP_OCR_MAX_PAGES=10
# SEAFILE_MCP_OCR_CONCURRENCY=4
# SEAFILE_MCP_OCR_TIMEOUT_S=120
# SEAFILE_MCP_OCR_MAX_TOKENS=4096
# SEAFILE_MCP_OCR_TEMPERATURE=0.1

# Pages that look blank (the empty back of a duplex scan) are not sent to the
# OCR model. A heuristic that errs towards sending; false switches it off.
# SEAFILE_MCP_OCR_SKIP_BLANK_PAGES=true

# JSON merged into every request, for model-specific knobs. Single-quote it so
# the inner double quotes survive. LightOnOCR-3:
# SEAFILE_MCP_OCR_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'
